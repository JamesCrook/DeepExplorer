+  static mount(ctxMix, node, params) {
+    const v = node.value || {};
+    const pid = v.bind ?? v.id;
+    const initVal = v.isData
+      ? (v.dataValue || v.default)
+      : (params[pid] ?? v.default ?? v.min ?? 0);
